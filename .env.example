# ============================================================
# Cairn 环境变量示例 — 复制为 .env 后填写
# 所有密钥只在服务端读取，绝不进入浏览器 bundle
# ============================================================

# ---------- Provider 密钥（按需配置，缺失的 Provider 自动禁用） ----------
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- Provider Base URL 覆盖（可选，用于代理/网关） ----------
# XAI_BASE_URL=https://api.x.ai/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ---------- 运行模式 ----------
# 置 1 时启用内置 Mock Provider（无需任何密钥，端到端可跑通，用于开发与测试）
CAIRN_MOCK=0

# ---------- 数据 ----------
# SQLite 数据库路径（相对 apps/web 运行目录或绝对路径）
CAIRN_DB_PATH=./data/cairn.db

# ---------- 安全与限额 ----------
# 每 IP 每分钟允许发起的搜索次数
CAIRN_RATE_LIMIT_RPM=30
# 单个会话内 Provider 调用的最大并发
CAIRN_MAX_CONCURRENCY=4
# 单次 Provider 调用默认超时（毫秒）
CAIRN_DEFAULT_TIMEOUT_MS=120000
# 抓取网页正文时是否允许访问私网地址（SSRF 防护，保持 0）
CAIRN_ALLOW_PRIVATE_HOSTS=0

# ---------- 可选：价格表（配置后对比页显示估算费用，单位 USD/百万 token） ----------
# CAIRN_PRICES_JSON={"grok-4":{"input":3,"output":15},"gpt-5":{"input":1.25,"output":10}}

# ---------- Web ----------
PORT=3000
